{
  "expo": {
    "name": "SkyCast",
    "slug": "WeatherApp",
    "version": "1.0.0",
    "description": "Live local weather, hourly conditions, and a seven-day forecast in a clear, beautiful view.",
    "orientation": "portrait",
    "icon": "./assets/images/skycast-icon.png",
    "scheme": "skycast",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/skycast-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087BEA",
        "foregroundImage": "./assets/images/skycast-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.invotyx.skycast"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/skycast-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SkyCast to show the weather for your current location."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087BEA",
          "image": "./assets/images/skycast-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/skycast-mark.png",
            "backgroundColor": "#061A33"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eec0b42a-f95e-4154-aeea-df287ff49d8b"
      }
    }
  }
}
